# Problem: Word Search
# Pattern: Backtracking / DFS
# Time: O(m * n * 4^L)
# Space: O(L)

from typing import List

class Solution:

    def exist(self, board: List[List[str]], word: str) -> bool:

        rows = len(board)
        cols = len(board[0])

        def dfs(r, c, i):

            if i == len(word):
                return True

            if (
                r < 0 or r >= rows
                or c < 0 or c >= cols
                or board[r][c] != word[i]
            ):
                return False

            temp = board[r][c]
            board[r][c] = "#"

            found = (
                dfs(r + 1, c, i + 1)
                or dfs(r - 1, c, i + 1)
                or dfs(r, c + 1, i + 1)
                or dfs(r, c - 1, i + 1)
            )

            board[r][c] = temp

            return found

        for r in range(rows):
            for c in range(cols):
                if dfs(r, c, 0):
                    return True

        return False


if __name__ == "__main__":

    sol = Solution()

    board1 = [
        ["A", "B", "C", "E"],
        ["S", "F", "C", "S"],
        ["A", "D", "E", "E"]
    ]

    board2 = [
        ["A", "B", "C", "E"],
        ["S", "F", "C", "S"],
        ["A", "D", "E", "E"]
    ]

    board3 = [
        ["A", "B", "C", "E"],
        ["S", "F", "C", "S"],
        ["A", "D", "E", "E"]
    ]

    print(sol.exist(board1, "ABCCED"))  # True
    print(sol.exist(board2, "SEE"))     # True
    print(sol.exist(board3, "ABCB"))    # False