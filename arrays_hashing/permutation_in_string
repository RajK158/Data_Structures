class Solution:
    def checkInclusion(self, s1: str, s2: str) -> bool:
        if len(s1) > len(s2):
            return False

        s1_count = [0] * 26
        window = [0] * 26

        for c in s1:
            s1_count[ord(c) - ord("a")] += 1

        l = 0

        for r in range(len(s2)):
            window[ord(s2[r]) - ord("a")] += 1

            if r - l + 1 > len(s1):
                window[ord(s2[l]) - ord("a")] -= 1
                l += 1

            if window == s1_count:
                return True

        return False


if __name__ == "__main__":
    sol = Solution()

    print(sol.checkInclusion("abc", "lecabee"))   # True
    print(sol.checkInclusion("abc", "lecaabee"))  # False
    print(sol.checkInclusion("ab", "eidbaooo"))   # True